# Zunara environment variables
# Copy to .env.local for local development and set the same values in Vercel.

# Public site URL (used for canonical URLs and sitemap)
# In production set this to your deployed domain, e.g. https://zunara.example.com
NEXT_PUBLIC_SITE_URL=https://zunara.example.com

# Neon Serverless PostgreSQL connection string (https://console.neon.tech)
DATABASE_URL=postgresql://user:password@ep-xxxx-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Secret used to authenticate the cron endpoint.
# Vercel sets this automatically for cron jobs. Any strong random string works.
CRON_SECRET=change-me-to-a-long-random-string
